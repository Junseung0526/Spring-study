{{>layouts/header}}


<table class="table">
    <thead>
    <tr>
        <th scope="col">Id</th>
        <th scope="col">Title</th>
        <th scope="col">Content</th>
        <th scope="col">Handle</th>
    </tr>
    </thead>
<tbody>
    {{#article}}
    <tr>
        <th>{{id}}</th>
        <th><a href="/article/{{id}}">{{title}}</a></th>
        <th>{{content}}</th>
    </tr>
    </tbody>
    {{/article}}
</table>
<a href="/article/{{id}}/edit" class="btn btn-primary">Edit</a>
<a href="/articles">Go to Article List</a>
{{>layouts/footer}}
